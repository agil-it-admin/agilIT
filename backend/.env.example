PAYLOAD_SECRET=dev-secret-change-me-in-production

# Local default: SQLite file. For Vercel / Cockroach, use a Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# First-time schema sync against Postgres (run once with seed):
# PAYLOAD_PUSH=true

# Marketing site origin (CORS / CSRF). On Vercel, set to your production domain.
FRONTEND_URL=http://localhost:3000

# Public URL of this Payload app (used for media URLs, admin links).
# Local: http://localhost:4001
# Vercel: https://YOUR_DOMAIN (same domain as the marketing site)
# PAYLOAD_PUBLIC_SERVER_URL=http://localhost:4001

# Vercel Blob (required for media uploads on Vercel).
# Create a Blob store in the Vercel project; Vercel injects this token automatically.
# BLOB_READ_WRITE_TOKEN=
