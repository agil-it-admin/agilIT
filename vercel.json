{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs",
      "installCommand": "cd .. && pnpm install",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "PAYLOAD_API_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "nextjs",
      "installCommand": "cd .. && pnpm install"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": { "service": "backend" }
    },
    {
      "source": "/admin/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
